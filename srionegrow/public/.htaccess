<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do not rewrite existing files or directories (assets, images, scripts)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Do not rewrite backend requests
  RewriteRule ^backend/ - [L]

  # 3. Everything else routes to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Ensure proper MIME types for JS modules
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>
